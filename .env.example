# Copie para .env (não versionado). Não coloque segredos neste arquivo.
# Caminhos relativos são resolvidos a partir da raiz do repositório.

# --- Fonte de dados (Ministério da Saúde / PNI) ---
PNI_API_BASE_URL=https://apidadosabertos.saude.gov.br
# O endpoint anual é montado pelo CLI a partir do argumento --year.
IBGE_SIDRA_BASE_URL=https://apisidra.ibge.gov.br
IBGE_POPULATION_TABLE=6579
IBGE_POPULATION_VARIABLE=9324
API_LIMIT=1000
API_TIMEOUT=120
# Filtra pela UF do paciente quando o campo estiver presente na fonte.
TARGET_UF=SP
RAW_FILE_NAME=pni_2024.jsonl
# Remove linhas idênticas do bruto. Use false se a fonte for por registro individual.
DEDUPLICATE_RAW=true

# --- Dados e artefatos ---
DATA_DIR=data
DUCKDB_PATH=data/processed/vax.duckdb
# Mapeamento colunas da fonte -> esquema canônico (JSON; ver docs/data/pipeline.md).
COLUMN_MAPPING_PATH=data/external/column_mapping.json
# População-alvo (CSV: municipality_code, year, [immunizer], population).
TARGET_POPULATION_PATH=data/external/target_population.csv
# Metas por imunizante (JSON {"<imunizante>": <meta %>}); opcional.
COVERAGE_TARGETS_PATH=data/external/coverage_targets.json
COVERAGE_TARGET_DEFAULT=95
ML_RANDOM_STATE=42

# --- Mapa ---
GEOJSON_PATH=data/external/sp_municipios.geojson
# Propriedade do GeoJSON com o código do município (depende do arquivo fornecido).
GEOJSON_CODE_PROPERTY=

# --- Backend (FastAPI) ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:4200
